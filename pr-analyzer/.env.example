# Copy this file to .env in the directory you run pr-analyzer from, then fill in what you need.
# Every value can also be set as a normal environment variable. Empty values use the default.

# GitHub personal access token. Optional for public repos (unauthenticated requests are limited
# to 60 per hour); required for private repos and for --post-review.
# Classic tokens need the "repo" scope for private repos. Fine-grained tokens need read access to
# Contents and Pull requests (write access to Pull requests for --post-review).
GITHUB_TOKEN=

# LLM review: ollama (local, the default), openai or anthropic
LLM_PROVIDER=ollama
# Empty = the provider's default (ollama: llama3.2, openai: gpt-4o-mini, anthropic: claude-haiku-5-5)
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Drop LLM suggestions whose confidence is below this value (0-1)
LLM_CONFIDENCE_THRESHOLD=0.5
LLM_TIMEOUT_SECONDS=120
# Diff lines sent to the LLM; anything beyond is left out of the prompt
MAX_DIFF_LINES=3000

# Semgrep ruleset (registry name, URL or local path) and tool time limits
SEMGREP_CONFIG=p/owasp-top-ten
SEMGREP_TIMEOUT_SECONDS=300
PIP_AUDIT_TIMEOUT_SECONDS=300

# DEBUG, INFO, WARNING or ERROR. Logs go to stderr; --verbose sets INFO.
LOG_LEVEL=WARNING
