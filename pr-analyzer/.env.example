# Copy this file to .env in the directory you run pr-analyzer from, then fill in what you need.
# Every value can also be set as a normal environment variable. Empty values use the default.

# GitHub personal access token. Optional for public repos (unauthenticated requests are limited
# to 60 per hour); required for private repos and for --post-review.
# Classic tokens need the "repo" scope for private repos. Fine-grained tokens need read access to
# Contents and Pull requests (write access to Pull requests for --post-review).
GITHUB_TOKEN=
# Files whose full content is fetched at the same time
GITHUB_MAX_WORKERS=8
# Longest wait, in seconds, for a GitHub rate limit to reset before retrying. A longer one fails
# the run while the PR is fetched (exit code 2); when the review is posted, it leaves the review
# out with a warning. 0 = never wait
GITHUB_RATE_LIMIT_MAX_WAIT_SECONDS=60

# LLM review: ollama (local, the default), openai or anthropic
LLM_PROVIDER=ollama
# Empty = the provider's default (ollama: llama3.2, openai: gpt-4o-mini, anthropic: claude-haiku-5-5)
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Drop LLM suggestions whose confidence is below this value (0-1)
LLM_CONFIDENCE_THRESHOLD=0.5
LLM_TIMEOUT_SECONDS=120
# Diff lines per LLM request; a bigger diff is reviewed in several requests
MAX_DIFF_LINES=3000
# Estimated prompt tokens (characters / 4) one run may send to the LLM. Files past it are not
# AI-reviewed, and the report says how many. Replies from the cache don't count. 0 = no limit
LLM_TOKEN_BUDGET=200000
# LLM requests in flight at once when a big PR is reviewed in parts. Keep 1 for Ollama, which
# may queue them; 2-4 suits OpenAI and Anthropic
LLM_MAX_CONCURRENCY=1

# Semgrep ruleset (registry name, URL or local path) and tool time limits
SEMGREP_CONFIG=p/owasp-top-ten
SEMGREP_TIMEOUT_SECONDS=300
PIP_AUDIT_TIMEOUT_SECONDS=300

# On-disk cache of file contents and LLM replies (--no-cache skips it for one run).
# Empty CACHE_DIR = $XDG_CACHE_HOME/pr-analyzer, or ~/.cache/pr-analyzer
CACHE_ENABLED=true
CACHE_DIR=
# Beyond this size the least recently used entries are removed, and so are entries unused for
# CACHE_MAX_AGE_DAYS
CACHE_MAX_SIZE_MB=500
CACHE_MAX_AGE_DAYS=30

# DEBUG, INFO, WARNING or ERROR. Logs go to stderr; --verbose sets INFO.
LOG_LEVEL=WARNING
