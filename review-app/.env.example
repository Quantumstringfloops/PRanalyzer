# Copy to .env in this folder (the one you run review-app from) and fill in what you need.
# Every value can also be set as an environment variable. Empty values use the default.

# ── The GitHub App (needed by `review-app webhook` and `review-app worker`) ──────────────────
GITHUB_APP_ID=
# path to the app's private key (.pem); keep it outside the repository
GITHUB_APP_PRIVATE_KEY_PATH=
# the secret set on the app's webhook; deliveries without a valid signature are refused
GITHUB_WEBHOOK_SECRET=

# ── `review-app analyze` without a GitHub App ─────────────────────────────────────────────────
# a personal access token: read access to the repository's contents and pull requests (write
# access to pull requests for --post-review)
GITHUB_TOKEN=

# ── The AI review: NVIDIA NIM (read by pr-analyzer) ───────────────────────────────────────────
# review-app uses LLM_PROVIDER=nvidia unless this says otherwise
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# empty = nvidia/nemotron-3-super-120b-a12b; any model id from build.nvidia.com works
LLM_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_THINKING=false

# ── review-app ────────────────────────────────────────────────────────────────────────────────
REVIEW_APP_DB=review-app.db
REVIEW_APP_POLICY=review-app.toml
# jobs worked on at once (1-8); each runs a whole analysis
REVIEW_APP_WORKERS=1
# seconds between looks at the queue when it's empty
REVIEW_APP_POLL_SECONDS=2
# largest webhook body accepted, in bytes
REVIEW_APP_MAX_WEBHOOK_BYTES=5242880
# true skips the AI review. With require_llm_review on (the default), nothing is then merged.
REVIEW_APP_SKIP_LLM=false
